# Public Site Configuration
NEXT_PUBLIC_APP_NAME=CertiDesk
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@certidesk.app
APP_BASE_URL=http://localhost:3000

# Firebase Client SDK (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=certidesk2-deb79.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=certidesk2-deb79
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=certidesk2-deb79.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=

# Firebase Admin SDK (Server-Only — NEVER expose to client)
FIREBASE_PROJECT_ID=certidesk2-deb79
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Cloud Secret Manager (Dedicated Least-Privilege Service Identity — Server-Only)
GCP_PROJECT_ID=certidesk2-deb79
GCP_SECRET_MANAGER_CLIENT_EMAIL=
GCP_SECRET_MANAGER_PRIVATE_KEY=

# Session Cookie Configuration (Server-Only)
SESSION_COOKIE_NAME=cd_session
SESSION_EXPIRES_IN_DAYS=5

# Comma-separated owner emails created in Firebase Console allowed to auto-provision as Super Admin on /su login
SUPER_ADMIN_EMAILS=

# Optional Fallback Razorpay Env Vars (Server-Only; primary credentials stored in Secret Manager)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
